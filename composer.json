{
  "name": "ernestdefoe/hero-builder",
  "description": "A fully customizable, animated hero banner for your Flarum discussion list — set the title, subtitle, any Font Awesome icon, a colour palette or a cover image, and live community stats. A polished, modern welcome.",
  "keywords": [
    "flarum",
    "flarum-extension",
    "hero",
    "banner",
    "welcome",
    "customization"
  ],
  "type": "flarum-extension",
  "license": "MIT",
  "authors": [
    {
      "name": "ernestdefoe",
      "email": "ernestdefoe@gmail.com"
    }
  ],
  "homepage": "https://github.com/ernestdefoe/hero-builder",
  "support": {
    "forum": "https://discuss.flarum.org/d/39479-hero-builder-built-with-ai",
    "issues": "https://github.com/ernestdefoe/hero-builder/issues",
    "source": "https://github.com/ernestdefoe/hero-builder"
  },
  "require": {
    "php": "^8.3",
    "flarum/core": "^2.0"
  },
  "require-dev": {
    "flarum/phpstan": "^2.0",
    "flarum/testing": "^2.0"
  },
  "autoload-dev": {
    "psr-4": {
      "ErnestDefoe\\HeroBuilder\\Tests\\": "tests/"
    }
  },
  "extra": {
    "flarum-extension": {
      "title": "Hero Builder",
      "category": "theme",
      "icon": {
        "name": "fas fa-meteor",
        "backgroundColor": "#7c3aed",
        "color": "#fff"
      }
    },
    "flarum-cli": {
      "modules": {
        "js": true,
        "css": true,
        "locale": true
      }
    }
  },
  "scripts": {
    "test": [
      "@test:integration"
    ],
    "test:integration": "phpunit -c tests/phpunit.integration.xml",
    "test:setup": "@php tests/integration/setup.php",
    "analyse:phpstan": "phpstan analyse"
  },
  "scripts-descriptions": {
    "test": "Runs all tests.",
    "test:integration": "Runs all integration tests.",
    "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
    "analyse:phpstan": "Run static analysis"
  },
  "minimum-stability": "beta",
  "prefer-stable": true
}
